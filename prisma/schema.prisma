generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStorageStatus {
  LOCAL
  UPLOADING
  READY
  FAILED
}

model User {
  id                 String   @id @default(cuid())
  name               String
  username           String   @unique
  email              String?  @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  role               String   @default("analyst")
  workspaceId        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  presences WorkspacePresence[]

  @@index([workspaceId])
}

model Workspace {
  id                        String   @id @default(cuid())
  name                      String
  managementPasswordHash    String?
  managementPasswordVersion Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  users          User[]
  seasons        Season[]
  clubs          Club[]
  competitions   Competition[]
  matches        Match[]
  momentTypes    MomentType[]
  subMomentTypes SubMomentType[]
  presences      WorkspacePresence[]
}

model WorkspacePresence {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  clientId    String
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, clientId])
  @@index([workspaceId, lastSeenAt])
  @@index([userId])
}

model Season {
  id        String   @id @default(cuid())
  name      String
  workspaceId String
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitions Competition[]
  matches      Match[]
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@unique([workspaceId, name])
}

model Club {
  id        String   @id @default(cuid())
  name      String
  workspaceId String
  shortName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitions   Competition[]
  opponentMatches Match[] @relation("OpponentClub")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@unique([workspaceId, name])
}

model Competition {
  id        String   @id @default(cuid())
  name      String
  seasonId  String
  workspaceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  clubs   Club[]
  matches Match[]
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([seasonId])
  @@unique([workspaceId, seasonId, name])
}

model Match {
  id                         String   @id @default(cuid())
  title                      String
  opponentName               String
  competition                String?
  season                     String?
  roundName                  String?
  matchDate                  DateTime?
  venue                      String?
  notes                      String?
  firstHalfStartSeconds      Float?
  firstHalfEndSeconds        Float?
  secondHalfStartSeconds     Float?
  secondHalfEndSeconds       Float?
  firstHalfAttackDirection   String   @default("left_to_right")
  secondHalfAttackDirection  String   @default("right_to_left")
  seasonId                   String?
  opponentClubId             String?
  competitionId              String?
  workspaceId                String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  video             Video?
  moments           Moment[]
  seasonRecord      Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  opponentClub      Club?        @relation("OpponentClub", fields: [opponentClubId], references: [id], onDelete: SetNull)
  competitionRecord Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([seasonId])
  @@index([opponentClubId])
  @@index([competitionId])
}

model Video {
  id              String   @id @default(cuid())
  matchId         String   @unique
  fileName        String
  fileSize        BigInt
  durationSeconds Float
  mimeType        String
  lastModified    DateTime?
  storageKey      String?  @unique
  storageStatus   VideoStorageStatus @default(LOCAL)
  uploadId        String?
  etag            String?
  uploadedAt      DateTime?
  mediaAssetId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId])
}

model MomentType {
  id              String   @id @default(cuid())
  name            String
  code            String
  workspaceId     String
  color           String
  defaultShortcut String?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  moments            Moment[]
  allowedSubmoments  SubMomentType[] @relation("MomentSubmomentTypes")
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@unique([workspaceId, code])
}

model SubMomentType {
  id                    String   @id @default(cuid())
  name                  String
  code                  String
  workspaceId           String
  color                 String
  requiresFieldLocation Boolean  @default(true)
  requiresGoalLocation  Boolean  @default(false)
  defaultShortcut       String?
  sortOrder             Int      @default(0)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subMoments        SubMoment[]
  allowedForMoments MomentType[] @relation("MomentSubmomentTypes")
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@unique([workspaceId, code])
}

model Moment {
  id               String   @id @default(cuid())
  matchId          String
  momentTypeId     String
  startTimeSeconds Float
  endTimeSeconds   Float
  durationSeconds  Float
  period            String?
  notes             String?
  outcome           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  momentType MomentType @relation(fields: [momentTypeId], references: [id])
  subMoments SubMoment[]

  @@index([matchId])
  @@index([momentTypeId])
}

model SubMoment {
  id              String   @id @default(cuid())
  momentId        String
  subMomentTypeId String
  timeSeconds     Float?
  fieldX          Float?
  fieldY          Float?
  goalX           Float?
  goalY           Float?
  foot            String?
  notes           String?
  outcome         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  moment        Moment        @relation(fields: [momentId], references: [id], onDelete: Cascade)
  subMomentType SubMomentType @relation(fields: [subMomentTypeId], references: [id])

  @@index([momentId])
  @@index([subMomentTypeId])
}
